+  /// where a velocity controller can bypass the physics-based IMU response.
+  public: bool deriveImuAccelFromVelocity{false};
+
+  public: bool derivedAccelInitialized{false};
+
+  public: double derivedAccelLastTime{0.0};
+
+  public: gz::math::Vector3d derivedAccelLastVelocity{0.0, 0.0, 0.0};
+
   /// \brief Have we initialized subscription to the IMU data yet?
