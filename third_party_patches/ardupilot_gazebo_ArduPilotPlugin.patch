@@ -520,6 +531,9 @@ void gz::sim::systems::ArduPilotPlugin::Configure(
     this->dataPtr->have32Channels =
     sdfClone->Get("have_32_channels", false).first;
 
+  this->dataPtr->deriveImuAccelFromVelocity =
+    sdfClone->Get("derive_imu_accel_from_velocity", false).first;
+
   // Add the signal handler
   this->dataPtr->sigHandler.AddCallback(
       std::bind(
@@ -1860,6 +1874,31 @@ void gz::sim::systems::ArduPilotPlugin::CreateStateJSON(
     gz::math::Vector3d velWldG = worldLinearVel->Data();
     gz::math::Vector3d velWldA = wldAToWldG.Rot() * velWldG + wldAToWldG.Pos();
 
+    // VelocityControl drives kinematic models without applying forces, so its
+    // reported velocity may change while the physics IMU does not observe the
+    // corresponding horizontal acceleration.  Keep the JSON velocity and IMU
+    // innovations consistent for models which explicitly opt in.
+    if (this->dataPtr->deriveImuAccelFromVelocity)
+    {
+        if (this->dataPtr->derivedAccelInitialized)
+        {
+            const double dt = _simTime - this->dataPtr->derivedAccelLastTime;
+            if (dt > 1e-6)
+            {
+                const gz::math::Vector3d accelWldA =
+                    (velWldA - this->dataPtr->derivedAccelLastVelocity) / dt;
+                const gz::math::Vector3d accelBdyA =
+                    wldAToBdyA.Rot().RotateVectorReverse(accelWldA);
+                linearAccel.X(accelBdyA.X());
+                linearAccel.Y(accelBdyA.Y());
+            }
+        }
+
+        this->dataPtr->derivedAccelLastVelocity = velWldA;
+        this->dataPtr->derivedAccelLastTime = _simTime;
+        this->dataPtr->derivedAccelInitialized = true;
+    }
+
     // require the duration since sim start in seconds
     double timestamp = _simTime;
 
