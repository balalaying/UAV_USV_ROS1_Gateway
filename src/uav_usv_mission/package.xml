<?xml version="1.0"?>
<package format="2">
  <name>uav_usv_mission</name>
  <version>0.1.0</version>
  <description>ROS 1 base station, Qt console and Gazebo Harmonic sensor bridge.</description>
  <maintainer email="team@example.com">UAV-USV Team</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>catkin</buildtool_depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_msgs</depend>
  <depend>uav_usv_interfaces</depend>
  <depend>uav_usv_ros1_compat</depend>
  <depend>visualization_msgs</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <exec_depend>python3-pyqt5</exec_depend>
  <export/>
</package>
