#!/bin/sh

# Run the standard PX4 SITL startup, then remove radio/GCS requirements for
# this DDS-only simulation. Flight and estimator checks remain enabled.
. ${R}etc/init.d-posix/rcS
param set NAV_DLL_ACT 0
param set COM_RCL_EXCEPT 4
param set COM_DLL_EXCEPT 4

# The generated x500 keeps its stock normalized hover thrust after mass and
# motor force are both scaled by s^3.  Its s^5 inertia needs a stronger rate
# controller, supplied only by the physically enlarged 332 launch profile.
if [ -n "$UAV_USV_MC_ROLLRATE_P" ]; then
    param set MC_ROLLRATE_P $UAV_USV_MC_ROLLRATE_P
    param set MC_PITCHRATE_P $UAV_USV_MC_PITCHRATE_P
    param set MC_YAWRATE_P $UAV_USV_MC_YAWRATE_P
    param set MC_ROLLRATE_I $UAV_USV_MC_ROLLRATE_I
    param set MC_PITCHRATE_I $UAV_USV_MC_PITCHRATE_I
    param set MC_YAWRATE_I $UAV_USV_MC_YAWRATE_I
    param set MC_ROLLRATE_K $UAV_USV_MC_ROLLRATE_K
    param set MC_PITCHRATE_K $UAV_USV_MC_PITCHRATE_K
    param set MC_YAWRATE_K $UAV_USV_MC_YAWRATE_K
fi
