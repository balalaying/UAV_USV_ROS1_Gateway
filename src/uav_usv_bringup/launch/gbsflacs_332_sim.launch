<launch>
  <arg name="start_gui" default="true"/>
  <arg name="enable_mid360" default="true"/>

  <!-- Full live implementation of the supplied escort-guard + GBSFLACS flow.
       The algorithm starts in escort mode, launches all UAVs in the same
       control cycle and moves all USVs.  It holds escort for 20 seconds,
       holds guard for 20 seconds, then automatically starts capture. -->
  <include file="$(find uav_usv_bringup)/launch/heterogeneous_332_qt_ros1.launch">
    <arg name="start_world" value="true"/>
    <arg name="start_ardupilot" value="true"/>
    <arg name="start_gui" value="$(arg start_gui)"/>
    <arg name="enable_mid360" value="$(arg enable_mid360)"/>
    <arg name="auto_demo" value="false"/>
    <arg name="start_gbsflacs" value="false"/>
    <arg name="start_algorithms" value="true"/>
    <arg name="algorithm_mode" value="escort"/>
    <arg name="algorithm_auto_start" value="true"/>
  </include>
</launch>
