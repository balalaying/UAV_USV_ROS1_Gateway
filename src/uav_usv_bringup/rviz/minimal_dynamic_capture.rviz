Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.65
      Cell Size: 5
      Class: rviz_default_plugins/Grid
      Color: 55; 65; 72
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Sea Grid
      Plane: XY
      Plane Cell Count: 80
      Reference Frame: map
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Dynamic Capture
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /capture/markers
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Nav2 Global Plan
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /plan
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 1
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Value: true
  Enabled: true
  Global Options:
    Background Color: 245; 247; 249
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 135
      Focal Point:
        X: 8
        Y: -8
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Capture Overview
      Near Clip Distance: 0.01
      Pitch: 1.1
      Target Frame: map
      Value: Orbit (rviz)
      Yaw: 0.72
Window Geometry:
  Height: 900
  Width: 1450
  X: 90
  Y: 45
