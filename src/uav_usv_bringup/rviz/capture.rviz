Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.85
      Cell Size: 20
      Class: rviz_default_plugins/Grid
      Color: 35; 35; 35
      Enabled: true
      Line Style:
        Line Width: 0.04
        Value: Lines
      Name: Capture Sea Grid
      Plane: XY
      Plane Cell Count: 80
      Reference Frame: map
      Value: true
    - Class: rviz_default_plugins/Axes
      Enabled: true
      Length: 30
      Name: Map Axes
      Radius: 0.6
      Reference Frame: map
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Cooperative Capture Markers
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /fleet/capture/markers
      Value: true
    - Alpha: 1
      Axes Length: 8
      Axes Radius: 0.5
      Class: rviz_default_plugins/Pose
      Color: 255; 80; 30
      Enabled: true
      Head Length: 3
      Head Radius: 1.2
      Name: Selected Capture Target
      Shaft Length: 10
      Shaft Radius: 0.8
      Shape: Arrow
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /fleet/base/selected_target
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Base Station Markers
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /fleet/base/markers
      Value: true
  Enabled: true
  Global Options:
    Background Color: 248; 248; 248
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 820
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Capture Overview
      Near Clip Distance: 0.01
      Pitch: 1.5707
      Target Frame: map
      Value: Orbit (rviz)
      Yaw: 0
Window Geometry:
  Height: 900
  Width: 1500
  X: 120
  Y: 60
