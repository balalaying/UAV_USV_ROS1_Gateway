Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.65
      Cell Size: 5
      Class: rviz_default_plugins/Grid
      Color: 55; 65; 72
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Sea Grid
      Plane: XY
      Plane Cell Count: 80
      Reference Frame: map
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Dynamic Capture
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /capture/markers
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Nav2 Global Plan
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /plan
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 25; 210; 220
      Color Transformer: FlatColor
      Decay Time: 0.8
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: USV-01 Mid-360 Preview
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.08
      Style: Points
      Topic:
        Depth: 2
        Durability Policy: Volatile
        Filter size: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /perception/usv_01/mid360/preview
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 0; 170; 255
      Color Transformer: FlatColor
      Decay Time: 0.3
      Enabled: false
      Name: Mid-360 Filtered Full Rate
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.06
      Style: Points
      Topic:
        Depth: 2
        Durability Policy: Volatile
        Filter size: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /perception/usv_01/points_filtered
      Use Fixed Frame: true
      Value: false
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 1
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Frames:
        All Enabled: true
        usv_01/mid360_link:
          Value: true
      Value: true
  Enabled: true
  Global Options:
    Background Color: 245; 247; 249
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 135
      Focal Point:
        X: 8
        Y: -8
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Capture With Mid-360
      Near Clip Distance: 0.01
      Pitch: 1.1
      Target Frame: map
      Value: Orbit (rviz)
      Yaw: 0.72
Window Geometry:
  Height: 900
  Width: 1450
  X: 90
  Y: 45
