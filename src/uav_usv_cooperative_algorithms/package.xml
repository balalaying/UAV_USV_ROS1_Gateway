<?xml version="1.0"?>
<package format="2">
  <name>uav_usv_cooperative_algorithms</name>
  <version>0.1.0</version>
  <description>ROS 1 live adapters for GB-SFLA-CS capture and escort guard algorithms.</description>
  <maintainer email="maintainer@example.com">UAV-USV Simulation Maintainer</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>geometry_msgs</depend>
  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>uav_usv_interfaces</depend>
  <depend>visualization_msgs</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-sklearn</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
</package>
