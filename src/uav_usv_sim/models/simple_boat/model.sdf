      <sensor name="front_camera" type="camera">
        <pose>2.31825 0 1.075 0 0 0</pose>
        <topic>/boat/front_camera</topic>
        <update_rate>20</update_rate>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>360</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>200</far>
          </clip>
        </camera>
        <always_on>true</always_on>
        <visualize>true</visualize>
      </sensor>

      <sensor name="front_lidar" type="gpu_lidar">
        <gz_frame_id>landing_boat/hull/front_lidar</gz_frame_id>
        <pose>0.9075 0 1.5625 0 0 0</pose>
        <topic>/boat/scan</topic>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>361</samples>
              <resolution>1</resolution>
              <min_angle>-1.5708</min_angle>
              <max_angle>1.5708</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.35</min>
            <max>80</max>
            <resolution>0.02</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.01</stddev>
          </noise>
          <visibility_mask>0x01</visibility_mask>
        </ray>
        <always_on>true</always_on>
        <visualize>true</visualize>
      </sensor>
    </link>

    <plugin
      filename="gz-sim-velocity-control-system"
      name="gz::sim::systems::VelocityControl">
      <topic>/model/simple_boat/cmd_vel</topic>
      <control_linear_velocity>true</control_linear_velocity>
      <control_angular_velocity>true</control_angular_velocity>
    </plugin>

    <plugin
      filename="gz-sim-pose-publisher-system"
      name="gz::sim::systems::PosePublisher">
      <publish_model_pose>true</publish_model_pose>
      <publish_link_pose>false</publish_link_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
      <publish_sensor_pose>false</publish_sensor_pose>
      <use_pose_vector_msg>false</use_pose_vector_msg>
      <topic>/boat/pose</topic>
      <update_frequency>30</update_frequency>
    </plugin>

    <plugin
      filename="libBoatWaveFollower.so"
      name="gz::sim::systems::BoatWaveFollower">
      <mean_z>0.55</mean_z>
      <heave_amplitude>0.11</heave_amplitude>
      <roll_amplitude>0.055</roll_amplitude>
      <pitch_amplitude>0.045</pitch_amplitude>
      <primary_frequency>1.1</primary_frequency>
      <secondary_frequency>1.7</secondary_frequency>
      <wave_number_x>0.35</wave_number_x>
      <wave_number_y>0.22</wave_number_y>
    </plugin>
  </model>
</sdf>
