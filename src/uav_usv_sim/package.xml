<?xml version="1.0"?>
<package format="2">
  <name>uav_usv_sim</name>
  <version>0.1.0</version>
  <description>Integrated UAV-USV Gazebo simulation assets and control tools.</description>

  <maintainer email="dji@example.com">dji</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>rospy</depend>
  <depend>geometry_msgs</depend>
  <depend>geographic_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>
  <depend>robot_state_publisher</depend>
  <depend>xacro</depend>
  <depend>uav_usv_interfaces</depend>
  <depend>uuid_msgs</depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-pymavlink</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export/>
</package>
