<?xml version="1.0"?>
<package format="3">
  <name>uav_usv_lv_dot_ros2</name>
  <version>0.1.0</version>
  <description>ROS 2 lifecycle wrapper for the native LV-DOT migration.</description>
  <maintainer email="dji@example.com">dji</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>diagnostic_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>lifecycle_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>uav_usv_interfaces</depend>
  <depend>uav_usv_lv_dot_core</depend>
  <depend>visualization_msgs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
