<?xml version="1.0"?>
<package format="3">
  <name>uav_usv_perception</name>
  <version>0.1.0</version>
  <description>MID-360, UAV camera, AIS, object tracking, and multi-sensor fusion.</description>
  <maintainer email="team@example.com">UAV-USV Team</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>catkin</buildtool_depend>
  <depend>geographic_msgs</depend>
  <depend>geometry_msgs</depend>
  <exec_depend>python3-gz-msgs10</exec_depend>
  <exec_depend>python3-gz-transport13</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <depend>rospy</depend>
  <depend>rosgraph_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_msgs</depend>
  <depend>uav_usv_interfaces</depend>
  <depend>uav_usv_ros1_compat</depend>
  <depend>vision_msgs</depend>
  <depend>visualization_msgs</depend>
  <exec_depend>rviz</exec_depend>
  <exec_depend>uav_usv_mission</exec_depend>
  <exec_depend>uav_usv_sim</exec_depend>
  <export/>
</package>
