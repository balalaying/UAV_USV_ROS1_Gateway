Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.65
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 55; 65; 72
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: map
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      Color: 40; 170; 220
      Color Transformer: FlatColor
      Decay Time: 0.4
      Enabled: true
      Name: Mid-360 Filtered
      Position Transformer: XYZ
      Size (Pixels): 3
      Style: Points
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /perception/usv_01/points_filtered
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: LV-DOT LiDAR Clusters
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /lv_dot/diagnostics/lidar_bboxes
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: LV-DOT Filtered Boxes
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /lv_dot/diagnostics/filtered_bboxes
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: LV-DOT Tracked Boxes
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /lv_dot/diagnostics/tracked_bboxes
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: LV-DOT Dynamic Boxes
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /lv_dot/onboard_detector/dynamic_bboxes
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: LV-DOT Velocity
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /lv_dot/onboard_detector/velocity_visualizaton
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: UAV-01 Camera
      Normalize Range: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /fleet/uplink/uav_01/camera/image_raw
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 1
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Update Interval: 0
      Value: true
  Enabled: true
  Global Options:
    Background Color: 245; 247; 249
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 24
      Focal Point:
        X: 3
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.65
      Target Frame: map
      Yaw: 0.8
    Saved: ~
Window Geometry:
  Height: 820
  Width: 1250
