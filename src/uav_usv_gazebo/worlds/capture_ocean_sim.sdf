<sdf version='1.10'>
  <world name='capture_ocean_sim'>
    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.82 0.84 0.86</ambient_light>
        <background_color>1 1 1</background_color>
        <camera_pose>-420 -430 340 0 1.05 0.74</camera_pose>
        <camera_clip><near>0.25</near><far>7000</far></camera_clip>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager"/>
      <plugin filename="InteractiveViewControl" name="Interactive view control"/>
      <plugin filename="CameraTracking" name="Camera Tracking"/>
      <plugin filename="MarkerManager" name="Marker manager"/>
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">121</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
        <use_event>true</use_event>
      </plugin>
    </gui>

    <plugin filename='gz-sim-physics-system' name='gz::sim::systems::Physics'/>
    <plugin filename='gz-sim-user-commands-system' name='gz::sim::systems::UserCommands'/>
    <plugin filename='gz-sim-scene-broadcaster-system' name='gz::sim::systems::SceneBroadcaster'/>
    <plugin filename='gz-sim-contact-system' name='gz::sim::systems::Contact'/>
    <plugin filename='gz-sim-sensors-system' name='gz::sim::systems::Sensors'>
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename='gz-sim-imu-system' name='gz::sim::systems::Imu'/>
    <plugin filename='gz-sim-air-pressure-system' name='gz::sim::systems::AirPressure'/>
    <plugin filename='gz-sim-magnetometer-system' name='gz::sim::systems::Magnetometer'/>
    <plugin filename='gz-sim-navsat-system' name='gz::sim::systems::NavSat'/>

    <physics type='ode'>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <scene>
      <grid>false</grid>
      <ambient>0.82 0.84 0.86 1</ambient>
      <background>1 1 1 1</background>
      <shadows>true</shadows>
    </scene>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.5461637398001464</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <model name='capture_ocean_plane'>
      <static>true</static>
      <link name='ocean_link'>
        <visual name='ocean_visual'>
          <pose>0 0 -0.02 0 0 0</pose>
          <geometry><plane><normal>0 0 1</normal><size>1400 1400</size></plane></geometry>
          <material>
            <ambient>0 0.08 0.16 0.48</ambient>
            <diffuse>0 0.18 0.3 0.48</diffuse>
            <specular>0.04 0.06 0.08 1</specular>
          </material>
        </visual>
        <collision name='ocean_collision'>
          <geometry><plane><normal>0 0 1</normal><size>1400 1400</size></plane></geometry>
        </collision>
      </link>
    </model>
    <include><uri>model://waves</uri><name>waves</name><pose>0 0 0.015 0 0 0</pose></include>

    <model name='red_lighthouse'>
      <static>true</static>
      <pose>-260 -120 0 0 0 0</pose>
      <link name='tower'>
        <collision name='collision'><pose>0 0 5 0 0 0</pose><geometry><cylinder><radius>2.2</radius><length>10</length></cylinder></geometry></collision>
        <visual name='base'><pose>0 0 0.4 0 0 0</pose><geometry><cylinder><radius>3.2</radius><length>0.8</length></cylinder></geometry><material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.18 0.18 0.16 1</diffuse></material></visual>
        <visual name='tower_color'><pose>0 0 5.2 0 0 0</pose><geometry><cylinder><radius>1.35</radius><length>10.4</length></cylinder></geometry><material><ambient>0.75 0.04 0.03 1</ambient><diffuse>0.95 0.06 0.04 1</diffuse></material></visual>
        <visual name='lantern'><pose>0 0 11.0 0 0 0</pose><geometry><sphere><radius>1.35</radius></sphere></geometry><material><ambient>1 0.86 0.35 1</ambient><diffuse>1 0.88 0.4 1</diffuse></material></visual>
        <light name='beacon' type='point'><pose>0 0 11 0 0 0</pose><intensity>2.5</intensity><diffuse>1 0.2 0.1 1</diffuse><attenuation><range>120</range><constant>0.7</constant><linear>0.02</linear><quadratic>0.001</quadratic></attenuation></light>
      </link>
    </model>
    <model name='green_lighthouse'>
      <static>true</static>
      <pose>250 -210 0 0 0 0</pose>
      <link name='tower'>
        <collision name='collision'><pose>0 0 5 0 0 0</pose><geometry><cylinder><radius>2.2</radius><length>10</length></cylinder></geometry></collision>
        <visual name='base'><pose>0 0 0.4 0 0 0</pose><geometry><cylinder><radius>3.2</radius><length>0.8</length></cylinder></geometry><material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.18 0.18 0.16 1</diffuse></material></visual>
        <visual name='tower_color'><pose>0 0 5.2 0 0 0</pose><geometry><cylinder><radius>1.35</radius><length>10.4</length></cylinder></geometry><material><ambient>0.03 0.55 0.16 1</ambient><diffuse>0.05 0.85 0.22 1</diffuse></material></visual>
        <visual name='lantern'><pose>0 0 11.0 0 0 0</pose><geometry><sphere><radius>1.35</radius></sphere></geometry><material><ambient>1 0.86 0.35 1</ambient><diffuse>1 0.88 0.4 1</diffuse></material></visual>
        <light name='beacon' type='point'><pose>0 0 11 0 0 0</pose><intensity>2.5</intensity><diffuse>0.2 1 0.3 1</diffuse><attenuation><range>120</range><constant>0.7</constant><linear>0.02</linear><quadratic>0.001</quadratic></attenuation></light>
      </link>
    </model>
    <model name='blue_lighthouse'>
      <static>true</static>
      <pose>320 170 0 0 0 0</pose>
      <link name='tower'>
        <collision name='collision'><pose>0 0 5 0 0 0</pose><geometry><cylinder><radius>2.2</radius><length>10</length></cylinder></geometry></collision>
        <visual name='base'><pose>0 0 0.4 0 0 0</pose><geometry><cylinder><radius>3.2</radius><length>0.8</length></cylinder></geometry><material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.18 0.18 0.16 1</diffuse></material></visual>
        <visual name='tower_color'><pose>0 0 5.2 0 0 0</pose><geometry><cylinder><radius>1.35</radius><length>10.4</length></cylinder></geometry><material><ambient>0.03 0.16 0.72 1</ambient><diffuse>0.05 0.25 0.95 1</diffuse></material></visual>
        <visual name='lantern'><pose>0 0 11.0 0 0 0</pose><geometry><sphere><radius>1.35</radius></sphere></geometry><material><ambient>1 0.86 0.35 1</ambient><diffuse>1 0.88 0.4 1</diffuse></material></visual>
        <light name='beacon' type='point'><pose>0 0 11 0 0 0</pose><intensity>2.5</intensity><diffuse>0.25 0.4 1 1</diffuse><attenuation><range>120</range><constant>0.7</constant><linear>0.02</linear><quadratic>0.001</quadratic></attenuation></light>
      </link>
    </model>
    <model name='yellow_lighthouse'>
      <static>true</static>
      <pose>-330 230 0 0 0 0</pose>
      <link name='tower'>
        <collision name='collision'><pose>0 0 5 0 0 0</pose><geometry><cylinder><radius>2.2</radius><length>10</length></cylinder></geometry></collision>
        <visual name='base'><pose>0 0 0.4 0 0 0</pose><geometry><cylinder><radius>3.2</radius><length>0.8</length></cylinder></geometry><material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.18 0.18 0.16 1</diffuse></material></visual>
        <visual name='tower_color'><pose>0 0 5.2 0 0 0</pose><geometry><cylinder><radius>1.35</radius><length>10.4</length></cylinder></geometry><material><ambient>0.9 0.65 0.02 1</ambient><diffuse>1 0.82 0.05 1</diffuse></material></visual>
        <visual name='lantern'><pose>0 0 11.0 0 0 0</pose><geometry><sphere><radius>1.35</radius></sphere></geometry><material><ambient>1 0.86 0.35 1</ambient><diffuse>1 0.88 0.4 1</diffuse></material></visual>
        <light name='beacon' type='point'><pose>0 0 11 0 0 0</pose><intensity>2.5</intensity><diffuse>1 0.9 0.25 1</diffuse><attenuation><range>120</range><constant>0.7</constant><linear>0.02</linear><quadratic>0.001</quadratic></attenuation></light>
      </link>
    </model>
    <model name='purple_lighthouse'>
      <static>true</static>
      <pose>35 310 0 0 0 0</pose>
      <link name='tower'>
        <collision name='collision'><pose>0 0 5 0 0 0</pose><geometry><cylinder><radius>2.2</radius><length>10</length></cylinder></geometry></collision>
        <visual name='base'><pose>0 0 0.4 0 0 0</pose><geometry><cylinder><radius>3.2</radius><length>0.8</length></cylinder></geometry><material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.18 0.18 0.16 1</diffuse></material></visual>
        <visual name='tower_color'><pose>0 0 5.2 0 0 0</pose><geometry><cylinder><radius>1.35</radius><length>10.4</length></cylinder></geometry><material><ambient>0.42 0.08 0.64 1</ambient><diffuse>0.58 0.18 0.86 1</diffuse></material></visual>
        <visual name='lantern'><pose>0 0 11.0 0 0 0</pose><geometry><sphere><radius>1.35</radius></sphere></geometry><material><ambient>1 0.86 0.35 1</ambient><diffuse>1 0.88 0.4 1</diffuse></material></visual>
        <light name='beacon' type='point'><pose>0 0 11 0 0 0</pose><intensity>2.5</intensity><diffuse>0.75 0.25 1 1</diffuse><attenuation><range>120</range><constant>0.7</constant><linear>0.02</linear><quadratic>0.001</quadratic></attenuation></light>
      </link>
    </model>
    <model name='cyan_lighthouse'>
      <static>true</static>
      <pose>0 -360 0 0 0 0</pose>
      <link name='tower'>
        <collision name='collision'><pose>0 0 5 0 0 0</pose><geometry><cylinder><radius>2.2</radius><length>10</length></cylinder></geometry></collision>
        <visual name='base'><pose>0 0 0.4 0 0 0</pose><geometry><cylinder><radius>3.2</radius><length>0.8</length></cylinder></geometry><material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.18 0.18 0.16 1</diffuse></material></visual>
        <visual name='tower_color'><pose>0 0 5.2 0 0 0</pose><geometry><cylinder><radius>1.35</radius><length>10.4</length></cylinder></geometry><material><ambient>0.02 0.58 0.66 1</ambient><diffuse>0.05 0.85 0.92 1</diffuse></material></visual>
        <visual name='lantern'><pose>0 0 11.0 0 0 0</pose><geometry><sphere><radius>1.35</radius></sphere></geometry><material><ambient>1 0.86 0.35 1</ambient><diffuse>1 0.88 0.4 1</diffuse></material></visual>
        <light name='beacon' type='point'><pose>0 0 11 0 0 0</pose><intensity>2.5</intensity><diffuse>0.2 0.95 1 1</diffuse><attenuation><range>120</range><constant>0.7</constant><linear>0.02</linear><quadratic>0.001</quadratic></attenuation></light>
      </link>
    </model>

    <include><name>capture_base_platform</name><pose>-120 -120 0 0 0 0</pose><uri>model://four_level_uav_platform</uri></include>
    <include><name>uav_01</name><pose>-120 -120 2.85 0 0 0</pose><uri>model://static_x500_fleet_uav_01</uri></include>
    <include><name>uav_02</name><pose>-120 -120 6.35 0 0 0</pose><uri>model://static_x500_fleet_uav_02</uri></include>
    <include><name>uav_03</name><pose>-120 -120 9.85 0 0 0</pose><uri>model://static_x500_fleet_uav_03</uri></include>
    <include><name>uav_04</name><pose>-120 -120 13.35 0 0 0</pose><uri>model://static_x500_fleet_uav_04</uri></include>
    <include><name>own_01</name><pose>-190 -162 0.35 0 0 0</pose><uri>model://defense_own_01_boat</uri></include>
    <include><name>own_02</name><pose>-186 -134 0.35 0 0 0</pose><uri>model://defense_own_02_boat</uri></include>
    <include><name>own_03</name><pose>-186 -104 0.35 0 0 0</pose><uri>model://defense_own_03_boat</uri></include>
    <include><name>own_04</name><pose>-190 -76 0.35 0 0 0</pose><uri>model://defense_own_04_boat</uri></include>
    <light name='directionallight' type='directional'>
      <pose>0 0 30 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.35 0.15 -0.92</direction>
      <diffuse>0.85 0.85 0.82 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
    </light>
  </world>
</sdf>
