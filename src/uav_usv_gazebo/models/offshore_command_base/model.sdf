<?xml version="1.0"?>
<sdf version="1.10">
  <model name="offshore_command_base">
    <static>true</static>
    <link name="building">
      <collision name="foundation_collision"><pose>0 0 1.0 0 0 0</pose><geometry><box><size>58 48 2</size></box></geometry></collision>
      <collision name="house_collision"><pose>0 0 10 0 0 0</pose><geometry><box><size>46 36 18</size></box></geometry></collision>
      <visual name="foundation"><pose>0 0 1.0 0 0 0</pose><geometry><box><size>58 48 2</size></box></geometry><material><ambient>0.12 0.14 0.16 1</ambient><diffuse>0.24 0.28 0.32 1</diffuse></material></visual>
      <visual name="house"><pose>0 0 10 0 0 0</pose><geometry><box><size>46 36 18</size></box></geometry><material><ambient>0.56 0.60 0.62 1</ambient><diffuse>0.78 0.82 0.84 1</diffuse><specular>0.2 0.2 0.2 1</specular></material></visual>
      <visual name="roof_left"><pose>0 9.1 21.2 0.48 0 0</pose><geometry><box><size>50 22 1.1</size></box></geometry><material><ambient>0.18 0.20 0.23 1</ambient><diffuse>0.32 0.36 0.40 1</diffuse></material></visual>
      <visual name="roof_right"><pose>0 -9.1 21.2 -0.48 0 0</pose><geometry><box><size>50 22 1.1</size></box></geometry><material><ambient>0.18 0.20 0.23 1</ambient><diffuse>0.32 0.36 0.40 1</diffuse></material></visual>
      <visual name="door"><pose>23.05 0 5.5 0 0 0</pose><geometry><box><size>0.25 6 9</size></box></geometry><material><ambient>0.08 0.10 0.12 1</ambient><diffuse>0.12 0.16 0.20 1</diffuse></material></visual>
      <visual name="window_1"><pose>23.1 10 11 0 0 0</pose><geometry><box><size>0.3 7 5</size></box></geometry><material><ambient>0.05 0.30 0.48 1</ambient><diffuse>0.10 0.48 0.72 1</diffuse><emissive>0.02 0.12 0.20 1</emissive></material></visual>
      <visual name="window_2"><pose>23.1 -10 11 0 0 0</pose><geometry><box><size>0.3 7 5</size></box></geometry><material><ambient>0.05 0.30 0.48 1</ambient><diffuse>0.10 0.48 0.72 1</diffuse><emissive>0.02 0.12 0.20 1</emissive></material></visual>
      <visual name="antenna"><pose>0 0 30 0 0 0</pose><geometry><cylinder><radius>0.5</radius><length>14</length></cylinder></geometry><material><ambient>0.35 0.36 0.38 1</ambient><diffuse>0.65 0.66 0.68 1</diffuse></material></visual>
      <visual name="beacon"><pose>0 0 37.3 0 0 0</pose><geometry><sphere><radius>1.1</radius></sphere></geometry><material><ambient>0.9 0.08 0.04 1</ambient><diffuse>1 0.12 0.06 1</diffuse><emissive>0.8 0.03 0.01 1</emissive></material></visual>
      <visual name="radar_pedestal"><pose>8 0 25 0 0 0</pose><geometry><cylinder><radius>1.4</radius><length>5</length></cylinder></geometry><material><ambient>0.12 0.14 0.16 1</ambient><diffuse>0.24 0.28 0.32 1</diffuse></material></visual>
      <visual name="radar_head"><pose>8 0 28 0 0 0</pose><geometry><box><size>5.5 0.5 1.1</size></box></geometry><material><ambient>0.08 0.22 0.28 1</ambient><diffuse>0.12 0.52 0.64 1</diffuse><emissive>0.02 0.12 0.16 1</emissive></material></visual>
      <sensor name="base_radar" type="gpu_lidar">
        <pose>8 0 28 0 0 0</pose>
        <topic>/base/radar/scan</topic>
        <update_rate>10</update_rate>
        <ray>
          <scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.1415926</min_angle><max_angle>3.1415926</max_angle></horizontal></scan>
          <range><min>3</min><max>700</max><resolution>0.2</resolution></range>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.03</stddev></noise>
        </ray>
        <always_on>true</always_on>
        <visualize>true</visualize>
      </sensor>
      <light name="base_beacon" type="point"><pose>0 0 37.3 0 0 0</pose><cast_shadows>false</cast_shadows><intensity>2</intensity><diffuse>1 0.16 0.08 1</diffuse><attenuation><range>100</range><constant>0.5</constant><linear>0.02</linear><quadratic>0.001</quadratic></attenuation></light>
    </link>
