<?xml version="1.0"?>
<sdf version="1.9">
  <model name="catalina_island">
    <static>true</static>

    <link name="terrain_link">

      <!-- Catalina 岛屿卫星地形 -->
      <visual name="terrain_visual">
        <pose>0 0 0 1.5707963267948966 0 0</pose>
        <cast_shadows>true</cast_shadows>

        <geometry>
          <mesh>
            <uri>meshes/scene.gltf</uri>

            <!--
              原模型约 41.6km × 35.5km。
              缩放 0.024 后约为 998m × 851m。
            -->
            <scale>0.024 0.024 0.024</scale>
          </mesh>
        </geometry>
      </visual>

      <!--
        Catalina glTF 只作为视觉地形。Gazebo Sim 8 的 DART/ODE 后端不能
        从该 glTF 创建 mesh collision，保留它会触发 ODE AABB 断言并使
        Gazebo 自动退出。地图外缘、基地山侧和任务障碍物使用独立的
        box/cylinder collision，不依赖此视觉网格。
      -->

    </link>
  </model>
</sdf>
