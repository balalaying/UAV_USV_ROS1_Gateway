<?xml version='1.0' ?>
<sdf version="1.6">
    <model name="waves_full_ocean">
        <static>true</static>
        <link name="link">
            <visual name="visual">
                <geometry>
                    <mesh>
                        <uri>meshes/mesh.dae</uri>
                        <scale>12 12 1</scale>
                    </mesh>
                </geometry>
                <plugin filename="ignition-gazebo-shader-param-system" name="ignition::gazebo::systems::ShaderParam">
                    <shader language="glsl">
                        <vertex>materials/programs/GerstnerWaves_vs_330.glsl</vertex>
                        <fragment>materials/programs/GerstnerWaves_fs_330.glsl</fragment>
                    </shader>
                    <shader language="metal">
                        <vertex>materials/programs/GerstnerWaves_vs.metal</vertex>
                        <fragment>materials/programs/GerstnerWaves_fs.metal</fragment>
                    </shader>
                    <param>
                        <shader>vertex</shader>
                        <name>Nwaves</name>
                        <type>int</type>
                        <value>3</value>
                    </param>
                    <param>
                        <shader>vertex</shader>
                        <name>rescale</name>
                        <type>float</type>
                        <value>0.68</value>
                    </param>
                    <param>
                        <shader>vertex</shader>
                        <name>bumpScale</name>
                        <type>float_array</type>
                        <value>260 185</value>
                    </param>
                    <param>
                        <shader>vertex</shader>
                        <name>bumpSpeed</name>
                        <type>float_array</type>
                        <value>0.13 0.072</value>
                    </param>
                    <param>
                        <shader>vertex</shader>
                        <name>amplitude</name>
                        <type>float_array</type>
                        <value>0.62 0.34 0.22</value>
                    </param>
                    <param>
                        <shader>vertex</shader>
                        <name>wavenumber</name>
                        <type>float_array</type>
                        <value>0.038 0.145 0.078</value>
                    </param>
                    <param>
                        <shader>vertex</shader>
                        <name>omega</name>
                        <type>float_array</type>
                        <value>0.92 2.05 1.36</value>
                    </param>
                    <param>
                        <shader>vertex</shader>
                        <name>dir0</name>
                        <type>float_array</type>
                        <value>-0.92 0.38</value>
                    </param>
                    <param>
                        <shader>vertex</shader>
                        <name>dir1</name>
                        <type>float_array</type>
                        <value>-0.35 0.94</value>
                    </param>
                    <param>
                        <shader>vertex</shader>
                        <name>dir2</name>
                        <type>float_array</type>
                        <value>0.82 0.57</value>
                    </param>
                    <param>
                        <shader>vertex</shader>
                        <name>steepness</name>
                        <type>float_array</type>
                        <value>1.05 1.35 0.92</value>
                    </param>
                    <param>
                        <shader>vertex</shader>
                        <name>tau</name>
                        <type>float</type>
                        <value>2.0</value>
                    </param>
                    <param>
                        <shader>vertex</shader>
                        <name>camera_position_object_space</name>
                    </param>
                    <param>
                        <shader>vertex</shader>
                        <name>worldviewproj_matrix</name>
                    </param>
                    <param>
                        <shader>vertex</shader>
                        <name>t</name>
                        <value>TIME</value>
                    </param>
                    <param>
                        <shader>fragment</shader>
                        <name>hdrMultiplier</name>
                        <type>float</type>
                        <value>0.42</value>
                    </param>
                    <param>
                        <shader>fragment</shader>
                        <name>fresnelPower</name>
                        <type>float</type>
                        <value>4.6</value>
                    </param>
                    <param>
                        <shader>fragment</shader>
                        <name>shallowColor</name>
                        <type>float_array</type>
                        <value>0.0 0.18 0.38 1.0</value>
                    </param>
                    <param>
                        <shader>fragment</shader>
                        <name>deepColor</name>
                        <type>float_array</type>
                        <value>0.0 0.065 0.17 1.0</value>
                    </param>
                    <param>
                        <shader>fragment</shader>
                        <name>cubeMap</name>
                        <type>texture_cube</type>
                        <value>materials/textures/skybox_lowres.dds</value>
                        <!-- arg: texture coord set index -->
                        <arg>1</arg>
                    </param>
                    <param>
                        <shader>fragment</shader>
                        <name>bumpMap</name>
                        <type>texture</type>
                        <value>materials/textures/wave_normals.dds</value>
                    </param>
                </plugin>
            </visual>
        </link>
    </model>
</sdf>
