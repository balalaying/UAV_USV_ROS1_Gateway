<?xml version="1.0"?>
<sdf version="1.10">
  <model name="sim332_friendly_ship">
    <pose>0 0 0.5 0 0 0</pose>
    <link name="hull">
      <gravity>false</gravity>
      <inertial>
        <mass>850</mass>
        <inertia>
          <ixx>1350</ixx><iyy>6900</iyy><izz>7800</izz>
        </inertia>
      </inertial>

      <!-- Approximately 1.5 times the regular 9 x 3.4 m task vessel. -->
      <collision name="main_hull_collision">
        <pose>-0.6 0 0 0 0 0</pose>
        <geometry><box><size>11.4 5.0 1.55</size></box></geometry>
      </collision>
      <collision name="bow_port_collision">
        <pose>5.65 1.15 0.02 0 0 0.43</pose>
        <geometry><box><size>3.2 1.25 1.45</size></box></geometry>
      </collision>
      <collision name="bow_starboard_collision">
        <pose>5.65 -1.15 0.02 0 0 -0.43</pose>
        <geometry><box><size>3.2 1.25 1.45</size></box></geometry>
      </collision>

      <visual name="red_lower_hull">
        <pose>-0.7 0 -0.12 0 0 0</pose>
        <geometry><box><size>11.6 4.8 1.15</size></box></geometry>
        <material><ambient>0.38 0.015 0.012 1</ambient><diffuse>0.78 0.035 0.025 1</diffuse><specular>0.55 0.18 0.12 1</specular></material>
      </visual>
      <visual name="red_bow_port">
        <pose>5.65 1.18 -0.10 0 0 0.43</pose>
        <geometry><box><size>3.35 1.10 1.10</size></box></geometry>
        <material><ambient>0.42 0.015 0.01 1</ambient><diffuse>0.86 0.04 0.025 1</diffuse><specular>0.58 0.18 0.12 1</specular></material>
      </visual>
      <visual name="red_bow_starboard">
        <pose>5.65 -1.18 -0.10 0 0 -0.43</pose>
        <geometry><box><size>3.35 1.10 1.10</size></box></geometry>
        <material><ambient>0.42 0.015 0.01 1</ambient><diffuse>0.86 0.04 0.025 1</diffuse><specular>0.58 0.18 0.12 1</specular></material>
      </visual>

      <visual name="yellow_main_deck">
        <pose>-0.7 0 0.63 0 0 0</pose>
        <geometry><box><size>11.0 4.45 0.28</size></box></geometry>
        <material><ambient>0.62 0.39 0.015 1</ambient><diffuse>1.0 0.68 0.035 1</diffuse><specular>0.48 0.42 0.20 1</specular></material>
      </visual>
      <visual name="yellow_foredeck">
        <pose>5.0 0 0.52 0 0 0</pose>
        <geometry><box><size>2.7 2.9 0.24</size></box></geometry>
        <material><ambient>0.68 0.43 0.02 1</ambient><diffuse>1.0 0.73 0.05 1</diffuse><specular>0.45 0.38 0.18 1</specular></material>
      </visual>

      <visual name="yellow_cabin">
        <pose>-2.3 0 1.55 0 0 0</pose>
        <geometry><box><size>4.1 3.25 1.65</size></box></geometry>
        <material><ambient>0.58 0.36 0.02 1</ambient><diffuse>0.96 0.62 0.035 1</diffuse><specular>0.38 0.33 0.18 1</specular></material>
      </visual>
      <visual name="red_cabin_roof">
        <pose>-2.3 0 2.48 0 0 0</pose>
        <geometry><box><size>4.55 3.65 0.24</size></box></geometry>
        <material><ambient>0.40 0.012 0.01 1</ambient><diffuse>0.82 0.03 0.02 1</diffuse><specular>0.48 0.16 0.12 1</specular></material>
      </visual>
      <visual name="front_window">
        <pose>-0.22 0 1.72 0 0 0</pose>
        <geometry><box><size>0.08 2.65 0.76</size></box></geometry>
        <material><ambient>0.01 0.05 0.07 1</ambient><diffuse>0.02 0.16 0.22 1</diffuse><specular>0.75 0.82 0.88 1</specular></material>
      </visual>
      <visual name="port_window">
        <pose>-2.45 1.65 1.72 0 0 0</pose>
        <geometry><box><size>2.9 0.08 0.72</size></box></geometry>
        <material><ambient>0.01 0.05 0.07 1</ambient><diffuse>0.02 0.16 0.22 1</diffuse><specular>0.75 0.82 0.88 1</specular></material>
      </visual>
      <visual name="starboard_window">
        <pose>-2.45 -1.65 1.72 0 0 0</pose>
        <geometry><box><size>2.9 0.08 0.72</size></box></geometry>
        <material><ambient>0.01 0.05 0.07 1</ambient><diffuse>0.02 0.16 0.22 1</diffuse><specular>0.75 0.82 0.88 1</specular></material>
      </visual>

      <visual name="yellow_port_stripe">
        <pose>-0.65 2.43 0.05 0 0 0</pose>
        <geometry><box><size>10.8 0.10 0.28</size></box></geometry>
        <material><ambient>0.72 0.46 0.02 1</ambient><diffuse>1.0 0.76 0.04 1</diffuse><emissive>0.08 0.04 0 1</emissive></material>
      </visual>
      <visual name="yellow_starboard_stripe">
        <pose>-0.65 -2.43 0.05 0 0 0</pose>
        <geometry><box><size>10.8 0.10 0.28</size></box></geometry>
        <material><ambient>0.72 0.46 0.02 1</ambient><diffuse>1.0 0.76 0.04 1</diffuse><emissive>0.08 0.04 0 1</emissive></material>
      </visual>

      <visual name="mast">
        <pose>-2.3 0 3.45 0 0 0</pose>
        <geometry><cylinder><radius>0.13</radius><length>1.7</length></cylinder></geometry>
        <material><ambient>0.15 0.16 0.17 1</ambient><diffuse>0.34 0.36 0.38 1</diffuse><specular>0.55 0.58 0.60 1</specular></material>
      </visual>
      <visual name="radar_bar">
        <pose>-2.3 0 4.28 0 0 0</pose>
        <geometry><box><size>0.28 2.3 0.18</size></box></geometry>
        <material><ambient>0.46 0.02 0.015 1</ambient><diffuse>0.90 0.04 0.025 1</diffuse><specular>0.50 0.18 0.12 1</specular></material>
      </visual>
      <visual name="beacon">
        <pose>-2.3 0 4.62 0 0 0</pose>
        <geometry><sphere><radius>0.20</radius></sphere></geometry>
        <material><ambient>0.8 0.35 0.01 1</ambient><diffuse>1 0.68 0.03 1</diffuse><emissive>0.55 0.22 0 1</emissive></material>
      </visual>
    </link>

    <plugin filename="libBoatWaveFollower.so" name="gz::sim::systems::BoatWaveFollower">
      <mean_z>0.78</mean_z>
      <heave_amplitude>0.05</heave_amplitude>
      <roll_amplitude>0.018</roll_amplitude>
      <pitch_amplitude>0.015</pitch_amplitude>
      <primary_frequency>0.9</primary_frequency>
      <secondary_frequency>1.35</secondary_frequency>
      <wave_number_x>0.24</wave_number_x>
      <wave_number_y>0.17</wave_number_y>
      <velocity_topic>cmd_vel</velocity_topic>
    </plugin>
  </model>
</sdf>
