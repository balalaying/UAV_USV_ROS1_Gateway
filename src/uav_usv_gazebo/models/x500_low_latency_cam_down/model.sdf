<?xml version="1.0"?>
<sdf version="1.9">
  <model name="x500_low_latency_cam_down">
    <self_collide>false</self_collide>
    <include merge="true">
      <uri>model://x500</uri>
    </include>
    <include merge="true">
      <uri>model://low_latency_down_camera</uri>
      <pose>0 0 0.1 0 1.5707 0</pose>
      <name>low_latency_down_camera</name>
    </include>
    <joint name="CameraJoint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
      <pose relative_to="base_link">0 0 0 0 1.5707 0</pose>
    </joint>
  </model>
</sdf>
