<?xml version="1.0"?>
<sdf version="1.10">
  <model name="green_channel_buoy">
    <link name="body">
      <inertial><mass>140</mass><inertia><ixx>65</ixx><iyy>65</iyy><izz>22</izz></inertia></inertial>
      <collision name="float_collision"><pose>0 0 0.45 0 0 0</pose><geometry><cylinder><radius>0.65</radius><length>0.9</length></cylinder></geometry></collision>
      <collision name="mast_collision"><pose>0 0 2.15 0 0 0</pose><geometry><cylinder><radius>0.1</radius><length>2.7</length></cylinder></geometry></collision>
      <visual name="float"><pose>0 0 0.45 0 0 0</pose><geometry><cylinder><radius>0.68</radius><length>0.9</length></cylinder></geometry><material><ambient>0.02 0.42 0.12 1</ambient><diffuse>0.03 0.72 0.2 1</diffuse><specular>0.2 0.3 0.2 1</specular></material></visual>
      <visual name="reflective_band"><pose>0 0 0.78 0 0 0</pose><geometry><cylinder><radius>0.69</radius><length>0.14</length></cylinder></geometry><material><ambient>0.85 0.88 0.75 1</ambient><diffuse>1 1 0.86 1</diffuse><emissive>0.15 0.15 0.1 1</emissive></material></visual>
      <visual name="mast"><pose>0 0 2.15 0 0 0</pose><geometry><cylinder><radius>0.075</radius><length>2.7</length></cylinder></geometry><material><ambient>0.02 0.25 0.07 1</ambient><diffuse>0.03 0.5 0.12 1</diffuse></material></visual>
      <visual name="topmark"><pose>0 0 3.45 0 0 0</pose><geometry><cone><radius>0.38</radius><length>0.75</length></cone></geometry><material><ambient>0.02 0.36 0.1 1</ambient><diffuse>0.03 0.68 0.18 1</diffuse></material></visual>
      <visual name="lantern"><pose>0 0 3.95 0 0 0</pose><geometry><sphere><radius>0.18</radius></sphere></geometry><material><ambient>0.08 0.8 0.2 1</ambient><diffuse>0.1 1 0.25 1</diffuse><emissive>0.05 0.8 0.16 1</emissive></material></visual>
      <light name="green_light" type="point"><pose>0 0 3.95 0 0 0</pose><cast_shadows>false</cast_shadows><intensity>1.4</intensity><diffuse>0.08 1 0.22 1</diffuse><specular>0.1 1 0.3 1</specular><attenuation><range>28</range><constant>0.7</constant><linear>0.04</linear><quadratic>0.002</quadratic></attenuation></light>
    </link>
    <plugin filename="libBoatWaveFollower.so" name="gz::sim::systems::BoatWaveFollower"><mean_z>0</mean_z><heave_amplitude>0.08</heave_amplitude><roll_amplitude>0.045</roll_amplitude><pitch_amplitude>0.038</pitch_amplitude><primary_frequency>0.9</primary_frequency><secondary_frequency>1.45</secondary_frequency><wave_number_x>0.2</wave_number_x><wave_number_y>0.16</wave_number_y></plugin>
  </model>
</sdf>
