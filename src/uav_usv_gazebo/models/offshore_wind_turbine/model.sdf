<?xml version="1.0"?>
<sdf version="1.10">
  <model name="offshore_wind_turbine">
    <link name="tower">
      <inertial><mass>80000</mass><inertia><ixx>8000000</ixx><iyy>8000000</iyy><izz>400000</izz></inertia></inertial>
      <collision name="foundation_collision"><pose>0 0 1.5 0 0 0</pose><geometry><cylinder><radius>4</radius><length>3</length></cylinder></geometry></collision>
      <collision name="tower_collision"><pose>0 0 15.5 0 0 0</pose><geometry><cylinder><radius>1.45</radius><length>26</length></cylinder></geometry></collision>
      <visual name="foundation"><pose>0 0 1.5 0 0 0</pose><geometry><cylinder><radius>4</radius><length>3</length></cylinder></geometry><material><ambient>0.72 0.5 0.04 1</ambient><diffuse>0.95 0.68 0.07 1</diffuse><specular>0.12 0.12 0.1 1</specular></material></visual>
      <visual name="tower_white"><pose>0 0 15.5 0 0 0</pose><geometry><cylinder><radius>1.5</radius><length>26</length></cylinder></geometry><material><ambient>0.75 0.77 0.76 1</ambient><diffuse>0.92 0.94 0.93 1</diffuse><specular>0.3 0.3 0.3 1</specular></material></visual>
      <visual name="navigation_band"><pose>0 0 5.2 0 0 0</pose><geometry><cylinder><radius>1.55</radius><length>2.1</length></cylinder></geometry><material><ambient>0.85 0.58 0.02 1</ambient><diffuse>1 0.72 0.04 1</diffuse></material></visual>
      <visual name="nacelle"><pose>0 0 29 0 0 0</pose><geometry><box><size>5.5 3.2 2.8</size></box></geometry><material><ambient>0.7 0.72 0.71 1</ambient><diffuse>0.88 0.9 0.89 1</diffuse><specular>0.3 0.3 0.3 1</specular></material></visual>
      <light name="aviation_light" type="point"><pose>0 0 31 0 0 0</pose><cast_shadows>false</cast_shadows><intensity>2</intensity><diffuse>1 0.03 0.02 1</diffuse><specular>1 0.08 0.04 1</specular><attenuation><range>70</range><constant>0.6</constant><linear>0.025</linear><quadratic>0.001</quadratic></attenuation></light>
    </link>
    <link name="rotor">
      <pose>2.9 0 29 0 0 0</pose>
      <inertial><mass>1800</mass><inertia><ixx>18000</ixx><iyy>36000</iyy><izz>36000</izz></inertia></inertial>
      <visual name="hub"><geometry><sphere><radius>1.15</radius></sphere></geometry><material><ambient>0.72 0.74 0.73 1</ambient><diffuse>0.9 0.92 0.91 1</diffuse></material></visual>
      <visual name="blade_1"><pose>0 0 5.8 0 0 0</pose><geometry><box><size>0.35 0.9 10.5</size></box></geometry><material><ambient>0.78 0.8 0.79 1</ambient><diffuse>0.96 0.97 0.95 1</diffuse><specular>0.25 0.25 0.25 1</specular></material></visual>
      <visual name="blade_2"><pose>0 -5.02 -2.9 2.0944 0 0</pose><geometry><box><size>0.35 0.9 10.5</size></box></geometry><material><ambient>0.78 0.8 0.79 1</ambient><diffuse>0.96 0.97 0.95 1</diffuse></material></visual>
      <visual name="blade_3"><pose>0 5.02 -2.9 4.18879 0 0</pose><geometry><box><size>0.35 0.9 10.5</size></box></geometry><material><ambient>0.78 0.8 0.79 1</ambient><diffuse>0.96 0.97 0.95 1</diffuse></material></visual>
    </link>
    <joint name="tower_world_joint" type="fixed"><parent>world</parent><child>tower</child></joint>
    <joint name="rotor_joint" type="revolute">
      <parent>tower</parent><child>rotor</child>
      <axis><xyz>1 0 0</xyz><limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper><velocity>2</velocity></limit></axis>
    </joint>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController"><joint_name>rotor_joint</joint_name><initial_velocity>0.55</initial_velocity></plugin>
  </model>
</sdf>
