  <visual name="wheelhouse"><pose>-1.9 0 1.35 0 0 0</pose><geometry><box><size>3.2 2.5 1.7</size></box></geometry><material><ambient>0.74 0.73 0.66 1</ambient><diffuse>0.9 0.89 0.8 1</diffuse></material></visual>
  <visual name="window"><pose>-0.28 0 1.62 0 0.1 0</pose><geometry><box><size>0.05 2.05 0.62</size></box></geometry><material><ambient>0.015 0.08 0.13 0.85</ambient><diffuse>0.025 0.22 0.38 0.85</diffuse><specular>0.8 0.9 1 1</specular></material></visual>
  <visual name="neutral_identity_roof"><pose>-1.9 0 2.24 0 0 0</pose><geometry><box><size>2.2 1.65 0.12</size></box></geometry><material><ambient>0.04 0.72 0.25 1</ambient><diffuse>0.05 0.95 0.32 1</diffuse><emissive>0.01 0.18 0.05 1</emissive></material></visual>
  <visual name="mast"><pose>-1.6 0 3.5 0 0 0</pose><geometry><cylinder><radius>0.065</radius><length>3.2</length></cylinder></geometry><material><ambient>0.15 0.15 0.13 1</ambient><diffuse>0.28 0.28 0.24 1</diffuse></material></visual>
  <visual name="port_outrigger"><pose>0.3 1.6 2.3 0.5 0.8 0</pose><geometry><cylinder><radius>0.055</radius><length>5.8</length></cylinder></geometry><material><ambient>0.55 0.55 0.5 1</ambient><diffuse>0.75 0.75 0.7 1</diffuse></material></visual>
