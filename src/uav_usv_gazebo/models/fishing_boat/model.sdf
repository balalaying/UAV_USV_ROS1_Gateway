  <light name="work_light" type="point"><pose>0 0 3.4 0 0 0</pose><cast_shadows>false</cast_shadows><intensity>1.2</intensity><diffuse>1 0.9 0.55 1</diffuse><attenuation><range>28</range><constant>0.8</constant><linear>0.04</linear><quadratic>0.002</quadratic></attenuation></light>
  <particle_emitter name="foam_wake" type="box"><pose>-5.6 0 -0.18 0 -1.5708 0</pose><emitting>true</emitting><size>0.2 1.9 0.25</size><particle_size>0.3 0.3 0.07</particle_size><lifetime>4</lifetime><min_velocity>0.55</min_velocity><max_velocity>1</max_velocity><scale_rate>0.58</scale_rate><rate>28</rate><color_start>0.88 0.96 1 0.7</color_start><color_end>0.72 0.88 0.95 0</color_end><particle_scatter_ratio>0.12</particle_scatter_ratio></particle_emitter>
