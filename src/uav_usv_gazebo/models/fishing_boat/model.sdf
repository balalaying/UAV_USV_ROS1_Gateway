  <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl"><initial_linear>0.82 0 0</initial_linear><initial_angular>0 0 -0.009</initial_angular><topic>/model/fishing_boat/cmd_vel</topic></plugin>
  <plugin filename="libBoatWaveFollower.so" name="gz::sim::systems::BoatWaveFollower"><mean_z>0.52</mean_z><heave_amplitude>0.09</heave_amplitude><roll_amplitude>0.05</roll_amplitude><pitch_amplitude>0.04</pitch_amplitude><primary_frequency>1</primary_frequency><secondary_frequency>1.55</secondary_frequency></plugin>
