<?xml version="1.0"?>
<sdf version="1.10"><model name="fishing_boat"><pose>0 0 0.48 0 0 0</pose><link name="hull">
  <enable_wind>true</enable_wind><inertial><mass>420</mass><inertia><ixx>360</ixx><iyy>2100</iyy><izz>2250</izz></inertia></inertial>
  <collision name="hull_collision"><geometry><box><size>10.5 3.2 1</size></box></geometry></collision>
  <visual name="blue_hull"><pose>0 0 -0.2 0 0 0</pose><geometry><box><size>10.2 3 0.68</size></box></geometry><material><ambient>0.025 0.16 0.3 1</ambient><diffuse>0.04 0.32 0.58 1</diffuse><specular>0.14 0.2 0.25 1</specular></material></visual>
