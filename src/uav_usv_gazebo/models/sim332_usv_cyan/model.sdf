<?xml version="1.0"?>
<sdf version="1.10">
  <model name="sim332_usv_cyan">
    <include merge="true"><uri>model://defense_own_03_boat</uri></include>
    <link name="identity_shell">
      <visual name="port_band"><pose>0 1.53 0.12 0 0 0</pose><geometry><box><size>4.5 0.06 0.52</size></box></geometry><material><ambient>0.01 0.42 0.48 1</ambient><diffuse>0.02 0.88 0.96 1</diffuse><emissive>0 0.10 0.12 1</emissive></material></visual>
      <visual name="starboard_band"><pose>0 -1.53 0.12 0 0 0</pose><geometry><box><size>4.5 0.06 0.52</size></box></geometry><material><ambient>0.01 0.42 0.48 1</ambient><diffuse>0.02 0.88 0.96 1</diffuse><emissive>0 0.10 0.12 1</emissive></material></visual>
      <visual name="roof_id"><pose>-0.55 0 1.62 0 0 0</pose><geometry><box><size>1.5 1.5 0.08</size></box></geometry><material><ambient>0.01 0.42 0.48 1</ambient><diffuse>0.02 0.88 0.96 1</diffuse></material></visual>
    </link>
    <joint name="identity_joint" type="fixed"><parent>hull</parent><child>identity_shell</child></joint>
    <link name="ardupilot_io_left"><pose>0 0 0.3 0 0 0</pose><inertial><mass>0.001</mass><inertia><ixx>0.000001</ixx><iyy>0.000001</iyy><izz>0.000001</izz></inertia></inertial></link>
    <link name="ardupilot_io_right"><inertial><mass>0.001</mass><inertia><ixx>0.000001</ixx><iyy>0.000001</iyy><izz>0.000001</izz></inertia></inertial></link>
    <joint name="ardupilot_left_joint" type="fixed"><parent>hull</parent><child>ardupilot_io_left</child></joint><joint name="ardupilot_right_joint" type="fixed"><parent>hull</parent><child>ardupilot_io_right</child></joint>
    <plugin name="ArduPilotPlugin" filename="ArduPilotPlugin"><fdm_addr>127.0.0.1</fdm_addr><fdm_port_in>9052</fdm_port_in><connectionTimeoutMaxCount>5</connectionTimeoutMaxCount><lock_step>0</lock_step><no_time_sync>1</no_time_sync><derive_imu_accel_from_velocity>true</derive_imu_accel_from_velocity><modelXYZToAirplaneXForwardZDown degrees="true">0 0 0 180 0 0</modelXYZToAirplaneXForwardZDown><gazeboXYZToNED degrees="true">0 0 0 180 0 90</gazeboXYZToNED><imuName>hull::ardupilot_imu</imuName><control channel="0"><jointName>ardupilot_left_joint</jointName><type>COMMAND</type><servo_min>1000</servo_min><servo_max>2000</servo_max><cmd_topic>/model/usv_03/ardupilot/left</cmd_topic></control><control channel="2"><jointName>ardupilot_right_joint</jointName><type>COMMAND</type><servo_min>1000</servo_min><servo_max>2000</servo_max><cmd_topic>/model/usv_03/ardupilot/right</cmd_topic></control></plugin>
    <plugin name="uav_usv_gazebo::ArduPilotRoverBridge" filename="ArduPilotRoverBridge"><left_topic>/model/usv_03/ardupilot/left</left_topic><right_topic>/model/usv_03/ardupilot/right</right_topic><output_topic>/model/own_03/cmd_vel</output_topic><max_speed>10.0</max_speed><max_yaw_rate>0.9</max_yaw_rate><max_linear_accel>2.0</max_linear_accel><max_yaw_accel>0.8</max_yaw_accel></plugin>
  </model>
</sdf>
