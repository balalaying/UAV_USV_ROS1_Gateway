<?xml version="1.0"?>
<sdf version="1.10">
  <model name="mid360_demo_usv">
    <pose>0 0 0.72 0 0 0</pose>

    <link name="base_link">
      <gravity>false</gravity>
      <inertial>
        <mass>260</mass>
        <inertia>
          <ixx>180</ixx>
          <iyy>920</iyy>
          <izz>1050</izz>
        </inertia>
      </inertial>

      <collision name="hull_collision">
        <pose>-0.2 0 0 0 0 0</pose>
        <geometry>
          <box><size>8.8 3.2 1.0</size></box>
        </geometry>
      </collision>

      <visual name="lower_hull">
        <pose>-0.25 0 -0.15 0 0 0</pose>
        <geometry>
          <box><size>8.7 3.15 0.75</size></box>
        </geometry>
        <material>
          <ambient>0.02 0.08 0.14 1</ambient>
          <diffuse>0.03 0.22 0.42 1</diffuse>
          <specular>0.3 0.4 0.5 1</specular>
        </material>
      </visual>

      <visual name="deck">
        <pose>-0.55 0 0.42 0 0 0</pose>
        <geometry>
          <box><size>7.4 2.9 0.22</size></box>
        </geometry>
        <material>
          <ambient>0.65 0.7 0.74 1</ambient>
          <diffuse>0.86 0.9 0.93 1</diffuse>
        </material>
      </visual>

      <visual name="cabin">
        <pose>-1.45 0 1.15 0 0 0</pose>
        <geometry>
          <box><size>2.3 2.1 1.35</size></box>
        </geometry>
        <material>
          <ambient>0.12 0.15 0.18 1</ambient>
          <diffuse>0.25 0.3 0.34 1</diffuse>
        </material>
      </visual>

      <visual name="cabin_window">
        <pose>-0.27 0 1.28 0 0 0</pose>
        <geometry>
          <box><size>0.04 1.65 0.55</size></box>
        </geometry>
        <material>
          <ambient>0.02 0.16 0.25 1</ambient>
          <diffuse>0.03 0.34 0.55 1</diffuse>
          <specular>0.8 0.9 1 1</specular>
        </material>
      </visual>

      <visual name="bow_left">
        <pose>4.25 0.8 0 0 0 0.42</pose>
        <geometry>
          <box><size>1.8 0.3 0.95</size></box>
        </geometry>
        <material>
          <ambient>0.02 0.08 0.14 1</ambient>
          <diffuse>0.03 0.22 0.42 1</diffuse>
        </material>
      </visual>

      <visual name="bow_right">
        <pose>4.25 -0.8 0 0 0 -0.42</pose>
        <geometry>
          <box><size>1.8 0.3 0.95</size></box>
        </geometry>
        <material>
          <ambient>0.02 0.08 0.14 1</ambient>
          <diffuse>0.03 0.22 0.42 1</diffuse>
        </material>
      </visual>

      <visual name="sensor_mast">
        <pose>0.65 0 1.3 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.08</radius><length>1.6</length></cylinder>
        </geometry>
        <material>
          <ambient>0.04 0.04 0.045 1</ambient>
          <diffuse>0.08 0.08 0.09 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="mid360_link">
      <pose relative_to="base_link">0.65 0 2.18 0 0 0</pose>
      <gravity>false</gravity>
      <inertial>
        <mass>0.265</mass>
        <inertia>
          <ixx>0.00015</ixx>
          <iyy>0.00015</iyy>
          <izz>0.00015</izz>
        </inertia>
      </inertial>

      <visual name="mid360_body">
        <geometry>
          <cylinder><radius>0.18</radius><length>0.18</length></cylinder>
        </geometry>
        <material>
          <ambient>0.04 0.04 0.045 1</ambient>
          <diffuse>0.08 0.08 0.09 1</diffuse>
          <specular>0.4 0.4 0.42 1</specular>
        </material>
      </visual>

      <visual name="mid360_lens">
        <pose>0 0 0.065 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.185</radius><length>0.055</length></cylinder>
        </geometry>
        <material>
          <ambient>0.03 0.26 0.3 1</ambient>
          <diffuse>0.05 0.65 0.72 1</diffuse>
          <specular>0.8 0.9 0.95 1</specular>
        </material>
      </visual>

      <sensor name="mid360_rgl" type="custom">
        <plugin
          filename="RGLServerPluginInstance"
          name="rgl::RGLServerPluginInstance">
          <range>
            <min>0.1</min>
            <max>70.0</max>
          </range>
          <update_rate>10</update_rate>
          <update_on_paused_sim>false</update_on_paused_sim>
          <topic>/usv_01/mid360_rgl/points</topic>
          <frame>usv_01/mid360_link</frame>
          <pattern_preset>Livox Mid360</pattern_preset>
        </plugin>
      </sensor>
    </link>

    <joint name="mid360_mount" type="fixed">
      <parent>base_link</parent>
      <child>mid360_link</child>
    </joint>

    <plugin
      filename="gz-sim-velocity-control-system"
      name="gz::sim::systems::VelocityControl">
      <topic>/model/usv_01/cmd_vel</topic>
      <control_linear_velocity>true</control_linear_velocity>
      <control_angular_velocity>true</control_angular_velocity>
    </plugin>

    <plugin
      filename="gz-sim-pose-publisher-system"
      name="gz::sim::systems::PosePublisher">
      <publish_model_pose>true</publish_model_pose>
      <publish_link_pose>false</publish_link_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
      <publish_sensor_pose>false</publish_sensor_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <update_frequency>30</update_frequency>
    </plugin>
  </model>
</sdf>
