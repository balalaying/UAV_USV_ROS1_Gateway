<?xml version="1.0"?>
<sdf version="1.10">
  <model name="static_x500_fleet_uav_02">
    <static>true</static>
    <include merge="true">
      <uri>model://x500_base</uri>
    </include>
    <link name="fleet_down_camera_link">
      <pose>0 0 0.35 0 1.5707 0</pose>
      <visual name="camera_body">
        <geometry><box><size>0.08 0.12 0.10</size></box></geometry>
        <material><ambient>0.02 0.02 0.025 1</ambient><diffuse>0.04 0.04 0.05 1</diffuse></material>
      </visual>
      <visual name="camera_lens">
        <pose>0.052 0 0 0 1.5707 0</pose>
        <geometry><cylinder><radius>0.025</radius><length>0.022</length></cylinder></geometry>
        <material><ambient>0.02 0.04 0.06 1</ambient><diffuse>0.04 0.09 0.13 1</diffuse><specular>0.8 0.9 1 1</specular></material>
      </visual>
      <sensor name="fleet_down_camera" type="camera">
        <pose>0.065 0 0 0 0 0</pose>
        <topic>/fleet/uplink/uav_02/camera</topic>
        <camera>
          <horizontal_fov>1.35</horizontal_fov>
          <image><width>320</width><height>180</height><format>R8G8B8</format></image>
          <clip><near>0.08</near><far>600</far></clip>
        </camera>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
      </sensor>
    </link>
    <joint name="FleetDownCameraJoint" type="fixed">
      <parent>base_link</parent>
      <child>fleet_down_camera_link</child>
    </joint>
  </model>
</sdf>
