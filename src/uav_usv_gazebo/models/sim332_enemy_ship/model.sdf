<?xml version="1.0"?>
<sdf version="1.10">
  <model name="sim332_enemy_ship">
    <include merge="true"><uri>model://scalable_capture_usv</uri></include>
    <link name="identity_shell">
      <visual name="black_deck"><pose>-0.25 0 0.62 0 0 0</pose><geometry><box><size>7.1 2.85 0.12</size></box></geometry><material><ambient>0.01 0.01 0.012 1</ambient><diffuse>0.025 0.025 0.03 1</diffuse></material></visual>
      <visual name="white_port"><pose>0 1.64 0.02 0 0 0</pose><geometry><box><size>6.8 0.08 0.55</size></box></geometry><material><ambient>0.8 0.8 0.8 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
      <visual name="white_starboard"><pose>0 -1.64 0.02 0 0 0</pose><geometry><box><size>6.8 0.08 0.55</size></box></geometry><material><ambient>0.8 0.8 0.8 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
      <visual name="hostile_identity_panel"><pose>-1.1 0 2.12 0 0 0</pose><geometry><box><size>1.5 2.25 0.20</size></box></geometry><material><ambient>0.55 0.01 0.01 1</ambient><diffuse>0.95 0.02 0.02 1</diffuse><emissive>0.12 0 0 1</emissive></material></visual>
    </link>
    <joint name="identity_joint" type="fixed"><parent>hull</parent><child>identity_shell</child></joint>
    <plugin filename="libRandomVesselMotion.so" name="gz::sim::systems::RandomVesselMotion">
      <command_topic>cmd_vel</command_topic>
      <seed>332</seed>
      <!-- Seeded slow random patrol in open water west of the protected ship.
           The geofence keeps it more than 100 m from friendly_ship and its
           speed remains well below the configured 10 m/s guard USVs. -->
      <min_speed>0.45</min_speed><max_speed>0.90</max_speed>
      <min_cruise_seconds>5</min_cruise_seconds><max_cruise_seconds>11</max_cruise_seconds>
      <min_stop_seconds>0.5</min_stop_seconds><max_stop_seconds>1.5</max_stop_seconds>
      <!-- Keep the target continuously underway; randomness comes from its
           heading, turn duration and cruise speed rather than full stops. -->
      <stop_probability>0.0</stop_probability>
      <max_heading_change>1.75</max_heading_change><turn_rate>0.45</turn_rate>
      <operating_center_x>-330</operating_center_x>
      <operating_center_y>-355</operating_center_y>
      <operating_radius>65</operating_radius><boundary_margin>15</boundary_margin>
      <!-- This western patrol box prevents random legs from targeting the
           friendly vessel at (-150,-355), while preserving visible turns. -->
      <patrol_min_x>-385</patrol_min_x><patrol_max_x>-270</patrol_max_x>
      <patrol_min_y>-420</patrol_min_y><patrol_max_y>-290</patrol_max_y>
      <patrol_lookahead_seconds>10.0</patrol_lookahead_seconds>
      <patrol_boundary_margin>18</patrol_boundary_margin>
      <!-- Dynamic collision avoidance uses the same inverse-distance
           repulsion idea as the supplied GBSFLACS programs. -->
      <avoid_radius>30</avoid_radius>
      <avoid_heading_gain>2.0</avoid_heading_gain>
      <avoid_model>friendly_ship</avoid_model>
      <avoid_model>usv_01</avoid_model>
      <avoid_model>usv_02</avoid_model>
      <avoid_model>usv_03</avoid_model>
    </plugin>
  </model>
</sdf>
