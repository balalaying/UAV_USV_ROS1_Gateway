<?xml version="1.0"?>
<sdf version="1.9">
  <model name="sim332_catalina_collision_proxy">
    <static>true</static>
    <link name="shoreline_proxy">
      <!-- Low compound hull: blocks surface vessels without creating a tall
           invisible obstacle for UAVs flying over the island. -->
      <!-- The current demonstration hulls are physically scaled.  Extending
           the continuous proxy from z=-2 to z=6 prevents a wave-lifted,
           high-speed hull from crossing over the former 3 m top edge. -->
      <collision name="west_tip"><pose>-340 -112 2.0 0 0 0.18</pose><geometry><box><size>190 78 8</size></box></geometry></collision>
      <collision name="west_body"><pose>-225 -72 2.0 0 0 0.18</pose><geometry><box><size>230 125 8</size></box></geometry></collision>
      <collision name="central_body"><pose>-35 0 2.0 0 0 0.16</pose><geometry><box><size>330 185 8</size></box></geometry></collision>
      <collision name="east_body"><pose>190 70 2.0 0 0 0.16</pose><geometry><box><size>300 160 8</size></box></geometry></collision>
      <collision name="east_tip"><pose>355 122 2.0 0 0 0.12</pose><geometry><box><size>150 90 8</size></box></geometry></collision>
    </link>
  </model>
</sdf>
