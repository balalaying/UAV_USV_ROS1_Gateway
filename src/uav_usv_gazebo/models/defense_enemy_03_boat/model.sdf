<?xml version="1.0"?>
<sdf version="1.10">
  <model name="defense_enemy_03_boat">
    <pose>0 0 0.45 0 0 0</pose>
    <link name="hull">
      <inertial>
        <mass>90</mass>
        <inertia>
          <ixx>35</ixx>
          <iyy>75</iyy>
          <izz>85</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="hull_collision">
        <geometry>
          <box>
            <size>4.2 1.7 0.55</size>
          </box>
        </geometry>
      </collision>
      <visual name="lower_hull">
        <pose>-0.05 0 -0.18 0 0 0</pose>
        <geometry>
          <box>
            <size>4.3 1.65 0.34</size>
          </box>
        </geometry>
        <material>
          <ambient>0.18 0.015 0.015 1</ambient>
          <diffuse>0.48 0.04 0.035 1</diffuse>
          <specular>0.18 0.08 0.08 1</specular>
        </material>
      </visual>
      <visual name="upper_hull">
        <pose>-0.2 0 0.10 0 0 0</pose>
        <geometry>
          <box>
            <size>3.8 1.45 0.42</size>
          </box>
        </geometry>
        <material>
          <ambient>0.28 0.01 0.05 1</ambient>
          <diffuse>0.70 0.03 0.12 1</diffuse>
          <specular>0.22 0.08 0.08 1</specular>
        </material>
      </visual>
      <visual name="bow_left">
        <pose>1.85 0.42 0.08 0 0 0.35</pose>
        <geometry>
          <box>
            <size>1.0 0.22 0.42</size>
          </box>
        </geometry>
        <material>
          <ambient>0.28 0.01 0.05 1</ambient>
          <diffuse>0.70 0.03 0.12 1</diffuse>
        </material>
      </visual>
      <visual name="bow_right">
        <pose>1.85 -0.42 0.08 0 0 -0.35</pose>
        <geometry>
          <box>
            <size>1.0 0.22 0.42</size>
          </box>
        </geometry>
        <material>
          <ambient>0.28 0.01 0.05 1</ambient>
          <diffuse>0.70 0.03 0.12 1</diffuse>
        </material>
      </visual>
      <visual name="cabin">
        <pose>-0.55 0 0.62 0 0 0</pose>
        <geometry>
          <box>
            <size>0.95 0.75 0.55</size>
          </box>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.055 1</ambient>
          <diffuse>0.12 0.12 0.13 1</diffuse>
        </material>
      </visual>
      <visual name="enemy_flag">
        <pose>-1.35 0 1.35 0 0 0</pose>
        <geometry>
          <box>
            <size>0.08 0.75 0.42</size>
          </box>
        </geometry>
        <material>
          <ambient>0.70 0 0 1</ambient>
          <diffuse>1 0 0 1</diffuse>
        </material>
      </visual>
    </link>
    <plugin
      filename="gz-sim-velocity-control-system"
      name="gz::sim::systems::VelocityControl">
      <topic>/model/enemy_03/cmd_vel</topic>
      <control_linear_velocity>true</control_linear_velocity>
      <control_angular_velocity>true</control_angular_velocity>
    </plugin>
    <plugin
      filename="libBoatWaveFollower.so"
      name="gz::sim::systems::BoatWaveFollower">
      <mean_z>0.50</mean_z>
      <heave_amplitude>0.09</heave_amplitude>
      <roll_amplitude>0.045</roll_amplitude>
      <pitch_amplitude>0.04</pitch_amplitude>
      <primary_frequency>1.15</primary_frequency>
      <secondary_frequency>1.65</secondary_frequency>
      <wave_number_x>0.34</wave_number_x>
      <wave_number_y>0.23</wave_number_y>
    </plugin>
  </model>
</sdf>
