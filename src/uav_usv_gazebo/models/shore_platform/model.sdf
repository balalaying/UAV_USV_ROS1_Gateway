<?xml version="1.0"?>
<sdf version="1.10">
  <model name="shore_platform">
    <static>true</static>
    <link name="offshore_base">
      <!-- Reinforced concrete caisson and steel service deck. -->
      <collision name="caisson_collision">
        <pose>0 0 0.55 0 0 0</pose>
        <geometry><box><size>30 22 1.1</size></box></geometry>
      </collision>
      <visual name="caisson_visual">
        <pose>0 0 0.55 0 0 0</pose>
        <geometry><box><size>30 22 1.1</size></box></geometry>
        <material>
          <ambient>0.13 0.15 0.16 1</ambient>
          <diffuse>0.25 0.28 0.29 1</diffuse>
          <specular>0.08 0.08 0.08 1</specular>
        </material>
      </visual>
      <collision name="deck_collision">
        <pose>0 0 1.28 0 0 0</pose>
        <geometry><box><size>29.6 21.6 0.24</size></box></geometry>
      </collision>
      <visual name="deck_visual">
        <pose>0 0 1.28 0 0 0</pose>
        <geometry><box><size>29.6 21.6 0.24</size></box></geometry>
        <material>
          <ambient>0.25 0.28 0.29 1</ambient>
          <diffuse>0.42 0.45 0.46 1</diffuse>
          <specular>0.16 0.16 0.16 1</specular>
        </material>
      </visual>
      <visual name="hazard_edge_north">
        <pose>0 10.72 1.42 0 0 0</pose>
        <geometry><box><size>29 0.28 0.05</size></box></geometry>
        <material><ambient>0.95 0.68 0.02 1</ambient><diffuse>1 0.78 0.04 1</diffuse></material>
      </visual>
      <visual name="hazard_edge_south">
        <pose>0 -10.72 1.42 0 0 0</pose>
        <geometry><box><size>29 0.28 0.05</size></box></geometry>
        <material><ambient>0.95 0.68 0.02 1</ambient><diffuse>1 0.78 0.04 1</diffuse></material>
      </visual>

      <!-- Raised helipad, centered at local x=6 m. -->
      <collision name="helipad_collision">
        <pose>6 0 1.42 0 0 0</pose>
        <geometry><cylinder><radius>5.3</radius><length>0.2</length></cylinder></geometry>
      </collision>
      <visual name="helipad_outer_disc">
        <pose>6 0 1.42 0 0 0</pose>
        <geometry><cylinder><radius>5.3</radius><length>0.2</length></cylinder></geometry>
        <material>
          <ambient>0.92 0.64 0.015 1</ambient>
          <diffuse>1 0.75 0.03 1</diffuse>
        </material>
      </visual>
      <visual name="helipad_inner_disc">
        <pose>6 0 1.535 0 0 0</pose>
        <geometry><cylinder><radius>4.92</radius><length>0.025</length></cylinder></geometry>
        <material>
          <ambient>0.055 0.065 0.07 1</ambient>
          <diffuse>0.1 0.12 0.13 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <visual name="helipad_h_left">
        <pose>6 1.05 1.555 0 0 0</pose>
        <geometry><box><size>3.5 0.42 0.035</size></box></geometry>
        <material><ambient>0.95 0.95 0.9 1</ambient><diffuse>1 1 0.96 1</diffuse></material>
      </visual>
      <visual name="helipad_h_right">
        <pose>6 -1.05 1.555 0 0 0</pose>
        <geometry><box><size>3.5 0.42 0.035</size></box></geometry>
        <material><ambient>0.95 0.95 0.9 1</ambient><diffuse>1 1 0.96 1</diffuse></material>
      </visual>
      <visual name="helipad_h_crossbar">
        <pose>6 0 1.558 0 0 0</pose>
        <geometry><box><size>0.42 2.5 0.04</size></box></geometry>
        <material><ambient>0.95 0.95 0.9 1</ambient><diffuse>1 1 0.96 1</diffuse></material>
      </visual>

      <!-- UAV hangar with an open-door facade and rooftop solar array. -->
      <collision name="hangar_collision">
        <pose>-7 0 3.5 0 0 0</pose>
        <geometry><box><size>9.5 9 4.2</size></box></geometry>
      </collision>
      <visual name="hangar_body">
        <pose>-7 0 3.5 0 0 0</pose>
        <geometry><box><size>9.5 9 4.2</size></box></geometry>
        <material>
          <ambient>0.48 0.52 0.54 1</ambient>
          <diffuse>0.7 0.74 0.75 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>
      <visual name="hangar_roof">
        <pose>-7 0 5.72 0 0 0</pose>
        <geometry><box><size>10 9.5 0.28</size></box></geometry>
        <material><ambient>0.15 0.17 0.18 1</ambient><diffuse>0.24 0.27 0.28 1</diffuse></material>
      </visual>
      <visual name="hangar_door">
        <pose>-2.235 0 3.2 0 0 0</pose>
        <geometry><box><size>0.06 6.6 3.35</size></box></geometry>
        <material>
          <ambient>0.035 0.045 0.05 1</ambient>
          <diffuse>0.07 0.09 0.1 1</diffuse>
          <specular>0.45 0.5 0.52 1</specular>
        </material>
      </visual>
      <visual name="hangar_sign">
        <pose>-2.19 0 5.15 0 0 0</pose>
        <geometry><box><size>0.04 4.6 0.42</size></box></geometry>
        <material><ambient>0.04 0.28 0.48 1</ambient><diffuse>0.06 0.5 0.82 1</diffuse><emissive>0.02 0.12 0.25 1</emissive></material>
      </visual>
      <visual name="solar_panel_a">
        <pose>-8.8 -2.2 5.98 0.12 0 0</pose>
        <geometry><box><size>3.2 3.4 0.1</size></box></geometry>
        <material><ambient>0.02 0.08 0.16 1</ambient><diffuse>0.03 0.18 0.38 1</diffuse><specular>0.8 0.85 0.9 1</specular></material>
      </visual>
      <visual name="solar_panel_b">
        <pose>-5.2 -2.2 5.98 0.12 0 0</pose>
        <geometry><box><size>3.2 3.4 0.1</size></box></geometry>
        <material><ambient>0.02 0.08 0.16 1</ambient><diffuse>0.03 0.18 0.38 1</diffuse><specular>0.8 0.85 0.9 1</specular></material>
      </visual>

      <!-- Elevated operations room and radar mast. -->
      <collision name="control_room_collision">
        <pose>-8 7.2 3.15 0 0 0</pose>
        <geometry><box><size>6 4.2 3.5</size></box></geometry>
      </collision>
      <visual name="control_room_body">
        <pose>-8 7.2 3.15 0 0 0</pose>
        <geometry><box><size>6 4.2 3.5</size></box></geometry>
        <material><ambient>0.76 0.78 0.76 1</ambient><diffuse>0.9 0.92 0.9 1</diffuse></material>
