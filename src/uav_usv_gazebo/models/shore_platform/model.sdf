      <visual name="control_room_window">
        <pose>-4.97 7.2 3.45 0 0 0</pose>
        <geometry><box><size>0.05 3.3 1.25</size></box></geometry>
        <material><ambient>0.015 0.08 0.13 0.85</ambient><diffuse>0.025 0.2 0.34 0.85</diffuse><specular>0.9 0.95 1 1</specular></material>
      </visual>
      <visual name="radar_mast">
        <pose>-8 7.2 6.6 0 0 0</pose>
        <geometry><cylinder><radius>0.12</radius><length>3.4</length></cylinder></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
      </visual>
      <visual name="radar_bar">
        <pose>-8 7.2 8.15 0 0 0.3</pose>
        <geometry><box><size>0.18 2.5 0.35</size></box></geometry>
        <material><ambient>0.82 0.84 0.82 1</ambient><diffuse>0.96 0.97 0.94 1</diffuse></material>
      </visual>

      <!-- Service crane and USV-side floating dock. -->
      <visual name="crane_tower">
        <pose>-12 -7.5 4 0 0 0</pose>
        <geometry><box><size>0.55 0.55 5.4</size></box></geometry>
        <material><ambient>0.92 0.52 0.015 1</ambient><diffuse>1 0.63 0.03 1</diffuse></material>
      </visual>
      <visual name="crane_boom">
        <pose>-9.4 -7.5 6.55 0 0 0</pose>
        <geometry><box><size>5.7 0.42 0.42</size></box></geometry>
        <material><ambient>0.92 0.52 0.015 1</ambient><diffuse>1 0.63 0.03 1</diffuse></material>
      </visual>
      <visual name="crane_cable">
        <pose>-7 -7.5 4.9 0 0 0</pose>
        <geometry><cylinder><radius>0.035</radius><length>3</length></cylinder></geometry>
        <material><ambient>0.04 0.04 0.04 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
      </visual>
      <collision name="service_dock_collision">
        <pose>5 -14 0.65 0 0 0</pose>
        <geometry><box><size>13 4 0.7</size></box></geometry>
      </collision>
      <visual name="service_dock_visual">
        <pose>5 -14 0.65 0 0 0</pose>
        <geometry><box><size>13 4 0.7</size></box></geometry>
        <material><ambient>0.22 0.18 0.12 1</ambient><diffuse>0.4 0.32 0.2 1</diffuse></material>
      </visual>
      <visual name="dock_fender_a">
        <pose>1 -16.05 0.55 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.32</radius><length>1.2</length></cylinder></geometry>
        <material><ambient>0.025 0.025 0.025 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
      <visual name="dock_fender_b">
        <pose>6 -16.05 0.55 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.32</radius><length>1.2</length></cylinder></geometry>
        <material><ambient>0.025 0.025 0.025 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
      <visual name="dock_fender_c">
        <pose>10 -16.05 0.55 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.32</radius><length>1.2</length></cylinder></geometry>
        <material><ambient>0.025 0.025 0.025 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>

      <!-- Shore connection and structural piles. -->
      <collision name="access_bridge_collision">
        <pose>-20 0 1.05 0 0 0</pose>
        <geometry><box><size>10 4 0.5</size></box></geometry>
      </collision>
      <visual name="access_bridge_visual">
        <pose>-20 0 1.05 0 0 0</pose>
        <geometry><box><size>10 4 0.5</size></box></geometry>
        <material><ambient>0.24 0.17 0.1 1</ambient><diffuse>0.44 0.3 0.16 1</diffuse></material>
      </visual>
      <visual name="pile_nw">
        <pose>-13 9 -1 0 0 0</pose>
        <geometry><cylinder><radius>0.48</radius><length>5</length></cylinder></geometry>
        <material><ambient>0.12 0.12 0.11 1</ambient><diffuse>0.2 0.2 0.18 1</diffuse></material>
      </visual>
      <visual name="pile_ne">
        <pose>13 9 -1 0 0 0</pose>
        <geometry><cylinder><radius>0.48</radius><length>5</length></cylinder></geometry>
        <material><ambient>0.12 0.12 0.11 1</ambient><diffuse>0.2 0.2 0.18 1</diffuse></material>
      </visual>
      <visual name="pile_sw">
        <pose>-13 -9 -1 0 0 0</pose>
        <geometry><cylinder><radius>0.48</radius><length>5</length></cylinder></geometry>
        <material><ambient>0.12 0.12 0.11 1</ambient><diffuse>0.2 0.2 0.18 1</diffuse></material>
      </visual>
      <visual name="pile_se">
        <pose>13 -9 -1 0 0 0</pose>
        <geometry><cylinder><radius>0.48</radius><length>5</length></cylinder></geometry>
        <material><ambient>0.12 0.12 0.11 1</ambient><diffuse>0.2 0.2 0.18 1</diffuse></material>
      </visual>

      <!-- Perimeter rails leave the access bridge and service dock openings clear. -->
      <visual name="rail_north">
        <pose>0 10.6 2.05 0 0 0</pose>
        <geometry><box><size>29 0.09 0.09</size></box></geometry>
        <material><ambient>0.58 0.6 0.6 1</ambient><diffuse>0.78 0.8 0.8 1</diffuse><specular>0.5 0.5 0.5 1</specular></material>
      </visual>
      <visual name="rail_east">
        <pose>14.55 1.5 2.05 0 0 0</pose>
        <geometry><box><size>0.09 18 0.09</size></box></geometry>
        <material><ambient>0.58 0.6 0.6 1</ambient><diffuse>0.78 0.8 0.8 1</diffuse></material>
      </visual>
      <visual name="rail_west_north">
        <pose>-14.55 6.5 2.05 0 0 0</pose>
        <geometry><box><size>0.09 8 0.09</size></box></geometry>
        <material><ambient>0.58 0.6 0.6 1</ambient><diffuse>0.78 0.8 0.8 1</diffuse></material>
      </visual>
      <visual name="rail_west_south">
        <pose>-14.55 -6.5 2.05 0 0 0</pose>
        <geometry><box><size>0.09 8 0.09</size></box></geometry>
        <material><ambient>0.58 0.6 0.6 1</ambient><diffuse>0.78 0.8 0.8 1</diffuse></material>
      </visual>

      <light name="helipad_beacon_n" type="point">
        <pose>6 5.4 1.75 0 0 0</pose><cast_shadows>false</cast_shadows><intensity>1.2</intensity>
        <diffuse>0.1 0.65 1 1</diffuse><specular>0.2 0.8 1 1</specular>
        <attenuation><range>22</range><constant>0.8</constant><linear>0.05</linear><quadratic>0.002</quadratic></attenuation>
      </light>
      <light name="helipad_beacon_s" type="point">
        <pose>6 -5.4 1.75 0 0 0</pose><cast_shadows>false</cast_shadows><intensity>1.2</intensity>
        <diffuse>0.1 0.65 1 1</diffuse><specular>0.2 0.8 1 1</specular>
        <attenuation><range>22</range><constant>0.8</constant><linear>0.05</linear><quadratic>0.002</quadratic></attenuation>
      </light>
      <light name="operations_beacon" type="point">
        <pose>-8 7.2 8.45 0 0 0</pose><cast_shadows>false</cast_shadows><intensity>2</intensity>
        <diffuse>1 0.12 0.04 1</diffuse><specular>1 0.25 0.1 1</specular>
        <attenuation><range>35</range><constant>0.7</constant><linear>0.04</linear><quadratic>0.002</quadratic></attenuation>
      </light>
