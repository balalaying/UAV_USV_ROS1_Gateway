<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.10">
  <model name="vrx_sydney_regatta_custom">
    <static>true</static>
    <link name="link">
      <visual name="visual_terrain">
        <geometry>
          <mesh>
            <uri>meshes/sydney_regatta.dae</uri>
            <scale>1.0 1.5 1.0</scale>
            <submesh><name>Terrain</name></submesh>
          </mesh>
        </geometry>
      </visual>
      <visual name="visual_dock_dark">
        <geometry>
          <mesh>
            <uri>meshes/sydney_regatta.dae</uri>
            <scale>1.0 1.5 1.0</scale>
            <submesh><name>DockDark</name></submesh>
          </mesh>
        </geometry>
      </visual>
      <visual name="visual_metal_galvanized">
        <geometry>
          <mesh>
            <uri>meshes/sydney_regatta.dae</uri>
            <scale>1.0 1.5 1.0</scale>
            <submesh><name>MetalGalvanized</name></submesh>
          </mesh>
        </geometry>
      </visual>
      <visual name="visual_dock">
        <geometry>
          <mesh>
            <uri>meshes/sydney_regatta.dae</uri>
            <scale>1.0 1.5 1.0</scale>
            <submesh><name>Dock</name></submesh>
          </mesh>
        </geometry>
      </visual>
      <visual name="visual_windows_dark">
        <geometry>
          <mesh>
            <uri>meshes/sydney_regatta.dae</uri>
            <scale>1.0 1.5 1.0</scale>
            <submesh><name>Windows_Dark</name></submesh>
          </mesh>
        </geometry>
      </visual>
      <visual name="visual_roof">
        <geometry>
          <mesh>
            <uri>meshes/sydney_regatta.dae</uri>
            <scale>1.0 1.5 1.0</scale>
            <submesh><name>RoofCorrugated</name></submesh>
          </mesh>
        </geometry>
      </visual>
      <visual name="visual_wall">
        <geometry>
          <mesh>
            <uri>meshes/sydney_regatta.dae</uri>
            <scale>1.0 1.5 1.0</scale>
            <submesh><name>Wall</name></submesh>
          </mesh>
        </geometry>
      </visual>
      <visual name="visual_branches">
        <geometry>
          <mesh>
            <uri>meshes/sydney_regatta.dae</uri>
            <scale>1.0 1.5 1.0</scale>
            <submesh><name>TreeDiffuse</name></submesh>
          </mesh>
        </geometry>
        <material>
          <diffuse>1.0 1.0 1.0 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>materials/textures/TreeDiffuse.png</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>meshes/sydney_regatta_shore.dae</uri>
            <scale>1.0 1.5 1.0</scale>
          </mesh>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
