<?xml version="1.0"?>
<package format="3">
  <name>uav_usv_base_station</name>
  <version>0.1.0</version>
  <description>Read-only base station service for fleet situation awareness.</description>
  <maintainer email="team@example.com">UAV-USV Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>launch</exec_depend>
